{
  "expo": {
    "name": "MerchantHQ",
    "slug": "commerce-manager",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc495988-69d5-49f2-8a4e-6845e2f59832"
    },
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.commercemanager.tablet",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser MerchantHQ à accéder aux photos pour choisir le logo de l’établissement."
        }
      ],
      "expo-notifications",
      "expo-background-task",
      "expo-updates",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "dc495988-69d5-49f2-8a4e-6845e2f59832"
      }
    },
    "owner": "teroryx"
  }
}
